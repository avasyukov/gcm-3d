<task numberOfSnaps="20" stepsPerSnap="2" xmlns:ndi="gcm3d.plugins.ndi">
	<system>
		<loadPlugin name="ndi" />
		<timeStep fixed="0.02" />                
		<meshMovement type="none" />
	        <prefix front="papper_$HEIGHT$_"/>
	</system>
	<bodies>
		<body id="steel">
                        <rheology type="elastic" />
                        <mesh id="main_mesh" type="geo2" file="models/my_models/papper_z_$HEIGHT$.geo" tetrSize="$TETR_SIZE$" /> <!-- sm -->

                        <mesh id="interp_mesh" type="cube" calc="false" h="$CUBE_H$" numX="$NUM_X$" numY="$NUM_Y$" numZ="2" />  <!-- sm. Mesh for calculating moments -->                
                        <!-- i_mesh needed here for moving interp_mesh -->
                        <transform type="translate" i_mesh="1" moveX="$MOVE_X$" moveY="$MOVE_Y$" moveZ="$MOVE_Z$" />

                        <material id="steel" />
                </body>
	</bodies>

    <materials>
                <material name="steel" rheology="isotropic">
			<!-- g / (sm * s^2 ) == 0.1 Pa-->
            <!-- -->
                        <la>8e11</la>
                        <mu>8e11</mu>
			<!-- g / sm^3 -->
                        <rho>7.8</rho>
                </material>
    </materials>

	<!--ndi:emitter name="em" sensor="true"-->
                <!--borderCondition calculator="ExternalForceCalculator" normalStress="1" tangentialStress="0.0" startTime = "0.0" type="sinus_gauss" omega="50000" tau="100e5">
		<area type="box" minX="4.5" maxX="5.5" minY="-0.01" maxY="0.01" minZ="-0.5" maxZ="0.5"/>
</borderCondition-->
		<!--values vy="100.0" /-->
	<!--/ndi:emitter-->

        <!-- there could be the moment sensor -->

        <initialState>
                <area type="box" minX="-20" maxX="20" minY="-20" maxY="20" minZ="-110" maxZ="10"/>
                <values vx="100" />
        </initialState>

</task>
