<task numberOfSnaps="150" stepsPerSnap="$PER_SNAP$" xmlns:ndi="gcm3d.plugins.ndi">
	<system>
		<loadPlugin name="ndi" />
		<timeStep fixed="$TAU$" />                
		<meshMovement type="none" />
	        <prefix front="papper_$HEIGHT_$_"/>
	</system>
	<bodies>
		<body id="steel">
                        <rheology type="elastic" />
                        <mesh id="main_mesh" type="geo2" file="models/shells/papper_z_$HEIGHT_$.geo" tetrSize="$TETR_SIZE$" />
                        

                        <mesh id="interp_mesh" type="rectangle" calc="false" sx="0.1" sy="0.1" sz="$SZ$" numX="100" numY="100" numZ="2" />  <!-- sm. Mesh for calculating moments -->                
